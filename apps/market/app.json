{
    "package": "com.astra.market",
    "name": "Market",
    "names": {
        "it": "Market"
    },
    "version": "2.0.0",
    "versionCode": 2,
    "description": "Discover and install apps for astraOS.",
    "descriptions": {
        "it": "Scopri e installa app per astraOS."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.INTERNET",
        "astra.permission.MANAGE_PACKAGES",
        "astra.permission.MEDIA"
    ],
    "opens": [
        "application/x-astra-apkg"
    ],
    "widgets": []
}
