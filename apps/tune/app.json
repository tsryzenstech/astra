{
    "package": "com.astra.tune",
    "name": "Tune",
    "version": "1.0.0",
    "versionCode": 3,
    "description": "Your music, YouTube Music and live radio, with the lock screen player and Control Center controls.",
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "Music",
    "webengine": true,
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.MEDIA",
        "astra.permission.INTERNET"
    ],
    "opens": [
        "audio/mpeg",
        "audio/flac",
        "audio/ogg",
        "audio/wav",
        "audio/x-wav",
        "audio/*"
    ],
    "widgets": [
        {
            "id": "nowplaying",
            "name": "Now playing",
            "qml": "widgets/NowPlaying.qml",
            "size": "wide"
        },
        {
            "id": "home",
            "name": "Tune",
            "qml": "widgets/Home.qml",
            "home": [
                "small",
                "medium"
            ]
        }
    ],
    "names": {
        "it": "Tune"
    },
    "appearance": "dark"
}
