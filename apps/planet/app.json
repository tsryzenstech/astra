{
    "package": "com.astra.planet",
    "name": "Planet",
    "names": {
        "it": "Planet"
    },
    "version": "1.0.0",
    "versionCode": 2,
    "description": "The web browser of astraOS: tabs, private browsing, Reader, bookmarks and Reading List.",
    "descriptions": {
        "it": "Il browser di astraOS: pannelli, navigazione privata, Lettura, preferiti ed Elenco lettura."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "webengine": true,
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.INTERNET",
        "astra.permission.MEDIA",
        "astra.permission.LOCATION",
        "astra.permission.CAMERA",
        "astra.permission.MICROPHONE"
    ],
    "opens": [
        "text/html",
        "application/xhtml+xml",
        "text/uri-list"
    ],
    "share": [
        "text/uri-list",
        "text/plain"
    ],
    "widgets": [
        {
            "id": "search",
            "name": "Search",
            "qml": "widgets/Search.qml",
            "size": "small"
        }
    ]
}
