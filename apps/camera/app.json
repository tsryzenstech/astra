{
    "package": "com.astra.camera",
    "name": "Camera",
    "version": "0.1.0",
    "versionCode": 1,
    "description": "Photos, videos and QR codes.",
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.CAMERA",
        "astra.permission.MICROPHONE",
        "astra.permission.MEDIA"
    ],
    "widgets": [
        {
            "id": "shutter",
            "name": "Camera",
            "qml": "widgets/Shutter.qml",
            "size": "small"
        },
        {
            "id": "home",
            "name": "Camera",
            "qml": "widgets/Home.qml",
            "home": [
                "small"
            ]
        }
    ],
    "names": {
        "it": "Fotocamera"
    },
    "appearance": "dark"
}
