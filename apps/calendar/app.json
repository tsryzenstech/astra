{
    "package": "com.astra.calendar",
    "name": "Calendar",
    "names": {
        "it": "Calendario"
    },
    "version": "1.0.0",
    "versionCode": 2,
    "description": "Your events, reminders and birthdays.",
    "descriptions": {
        "it": "I tuoi eventi, promemoria e compleanni."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.CALENDAR"
    ],
    "widgets": [
        {
            "id": "home",
            "name": "Calendar",
            "qml": "widgets/Home.qml",
            "home": [
                "small",
                "medium",
                "large"
            ]
        }
    ]
}
