{
    "package": "com.astra.meetup",
    "name": "MeetUp",
    "version": "1.0.0",
    "versionCode": 2,
    "description": "Video and audio calls with anyone, from a contact or a link.",
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.INTERNET",
        "astra.permission.CAMERA",
        "astra.permission.MICROPHONE",
        "astra.permission.CONTACTS"
    ],
    "widgets": [
        {
            "id": "home",
            "name": "MeetUp",
            "qml": "widgets/Home.qml",
            "home": [
                "small"
            ]
        }
    ],
    "names": {
        "it": "MeetUp"
    },
    "appearance": "dark",
    "webengine": true
}
