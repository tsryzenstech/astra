{
    "package": "com.astra.phone",
    "name": "Phone",
    "version": "0.1.0",
    "versionCode": 1,
    "description": "Calls, contacts and voicemail.",
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.PHONE",
        "astra.permission.CONTACTS"
    ],
    "widgets": [
        {
            "id": "missed",
            "name": "Missed calls",
            "qml": "widgets/Missed.qml",
            "size": "small"
        },
        {
            "id": "home",
            "name": "Phone",
            "qml": "widgets/Home.qml",
            "home": [
                "small"
            ]
        }
    ],
    "names": {
        "it": "Telefono"
    }
}
