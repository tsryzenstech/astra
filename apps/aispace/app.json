{
    "package": "com.astra.aispace",
    "name": "Cloudy",
    "names": {
        "it": "Cloudy"
    },
    "version": "1.0.0",
    "versionCode": 2,
    "description": "Cloudy, the astraOS assistant, running on your phone.",
    "descriptions": {
        "it": "Cloudy, l'assistente di astraOS, che funziona sul tuo telefono."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.INTERNET",
        "astra.permission.ALARMS",
        "astra.permission.CALENDAR"
    ],
    "widgets": [
        {
            "id": "home",
            "name": "AI Space",
            "qml": "widgets/Home.qml",
            "home": [
                "small",
                "medium"
            ]
        }
    ]
}
