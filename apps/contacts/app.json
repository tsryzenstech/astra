{
    "package": "com.astra.contacts",
    "name": "Contacts",
    "names": {
        "it": "Contatti"
    },
    "version": "1.0.0",
    "versionCode": 2,
    "description": "Everyone you know, in one place.",
    "descriptions": {
        "it": "Tutte le persone che conosci, in un unico posto."
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#000000",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.CONTACTS",
        "astra.permission.MEDIA"
    ],
    "widgets": [
        {
            "id": "home",
            "name": "Contacts",
            "qml": "widgets/Home.qml",
            "home": [
                "small",
                "medium"
            ]
        }
    ],
    "opens": [
        "text/vcard",
        "text/x-vcard"
    ]
}
