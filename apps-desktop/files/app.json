{
    "package": "com.astra.files",
    "name": "Files",
    "names": {
        "it": "File"
    },
    "version": "0.1.0",
    "versionCode": 1,
    "description": "Browse and manage the files on your computer.",
    "descriptions": {
        "it": "Sfoglia e gestisci i file del computer."
    },
    "target": "desktop",
    "desktop": {
        "width": 980,
        "height": 620,
        "minWidth": 620,
        "minHeight": 380
    },
    "main": "qml/Main.qml",
    "icon": "icon.svg",
    "background": "#141416",
    "category": "system",
    "launcher": {
        "visible": true
    },
    "permissions": [
        "astra.permission.MEDIA",
        "astra.permission.NEARBY_DEVICES"
    ],
    "share": [
        "*/*"
    ],
    "opens": [
        "inode/directory"
    ]
}
