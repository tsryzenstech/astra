# Connectivity: the D-Bus system bus and the standard Linux daemons astrad
# drives for Wi-Fi (iwd), Bluetooth (BlueZ) and mobile data and calls
# (ModemManager, which asks PolicyKit who may use the modem), plus the
# Qualcomm helpers that bring up the modem and the
# Wi-Fi/Bluetooth firmware on Snapdragon phones (rmtfs, pd-mapper,
# tqftpserv). Daemons that are not installed are skipped by the launcher.

on post-fs-data
    mkdir /run/dbus 0755 messagebus messagebus
    mkdir /data/var 0755 root root
    symlink /run /data/var/run
    mkdir /data/var/lib 0755 root root
    mkdir /data/var/lib/iwd 0700 root root
    mkdir /data/var/lib/bluetooth 0700 root root
    mkdir /data/var/lib/ModemManager 0700 root root
    mkdir /data/var/lib/dbus 0755 messagebus messagebus
    mkdir /data/var/lib/polkit-1 0700 polkitd polkitd
    exec -- /system/bin/sh /system/etc/connectivity/launch.sh prepare
    start dbus

service dbus /system/bin/sh /system/etc/connectivity/launch.sh dbus
    class core

service pd-mapper /system/bin/sh /system/etc/connectivity/launch.sh pd-mapper
    class core

service tqftpserv /system/bin/sh /system/etc/connectivity/launch.sh tqftpserv
    class core

service rmtfs /system/bin/sh /system/etc/connectivity/launch.sh rmtfs
    class core

service polkitd /system/bin/sh /system/etc/connectivity/launch.sh polkitd
    class core

service iwd /system/bin/sh /system/etc/connectivity/launch.sh iwd
    class main

service bluetoothd /system/bin/sh /system/etc/connectivity/launch.sh bluetoothd
    class main

service modemmanager /system/bin/sh /system/etc/connectivity/launch.sh modemmanager
    class main

# Audio: PipeWire and WirePlumber, and its PulseAudio server, which is what Qt
# Multimedia talks to. hexagonrpcd answers the ADSP's sensor process.
service hexagonrpcd /system/bin/sh /system/etc/connectivity/launch.sh hexagonrpcd
    class core

service pipewire /system/bin/sh /system/etc/connectivity/launch.sh pipewire
    class main

service wireplumber /system/bin/sh /system/etc/connectivity/launch.sh wireplumber
    class main

service pipewire-pulse /system/bin/sh /system/etc/connectivity/launch.sh pipewire-pulse
    class main
