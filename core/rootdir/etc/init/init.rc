# astraOS - system boot sequence
#
# Executed by /system/bin/init (second stage). The root filesystem is the
# read-only system partition: /sdcard, /mnt and the other root entries are
# created when the image is built. Triggers run in order:
#   early-init -> init -> fs -> post-fs-data -> boot
# Components ship their own .rc files next to this one
# (bootanim.rc, astrad.rc, sysboard.rc); vendor specific rules live in
# /vendor/etc/init.

on early-init
    # The console level is set by the first stage (quiet, or everything
    # with astra.verbose on the kernel command line).
    mkdir /dev/socket 0755 root root
    mkdir /run/astra 0775 root system
    mkdir /run/astra/display 0770 system graphics
    mkdir /run/user 0755 root root
    symlink /proc/self/fd /dev/fd
    symlink /proc/self/fd/0 /dev/stdin
    symlink /proc/self/fd/1 /dev/stdout
    symlink /proc/self/fd/2 /dev/stderr
    hostname astra

on init
    write /proc/sys/kernel/panic_on_oops 1
    write /proc/sys/kernel/kptr_restrict 2
    write /proc/sys/vm/overcommit_memory 1
    start ueventd
    exec -- /system/bin/udevadm trigger --action=add
    exec -- /system/bin/udevadm settle --timeout=10
    chmod 0666 /dev/dri/card0
    chmod 0666 /dev/dri/card1
    chmod 0666 /dev/dri/renderD128
    chown system graphics /dev/dri/card0
    chown system graphics /dev/dri/card1
    chown system graphics /dev/dri/renderD128
    start bootanim

on fs
    mount_all /vendor/etc/fstab

on post-fs-data
    # Android style /data layout
    mkdir /data/system 0775 system system
    mkdir /data/system/users 0775 system system
    mkdir /data/system/users/0 0775 system system
    mkdir /data/app 0771 system system
    mkdir /data/data 0771 system system
    mkdir /data/user 0711 system system
    symlink /data/data /data/user/0
    # Shared storage: group media_rw (apps holding the MEDIA permission),
    # setgid so everything created inside stays in the group.
    mkdir /data/media 2775 system media_rw
    mkdir /data/media/0 2775 system media_rw
    mkdir /data/media/0/DCIM 2775 system media_rw
    mkdir /data/media/0/DCIM/Camera 2775 system media_rw
    mkdir /data/media/0/Pictures 2775 system media_rw
    mkdir /data/media/0/Pictures/Screenshots 2775 system media_rw
    mkdir /data/media/0/Download 2775 system media_rw
    mkdir /data/media/0/Music 2775 system media_rw
    mkdir /data/media/0/Movies 2775 system media_rw
    mkdir /data/media/0/Documents 2775 system media_rw
    mkdir /data/misc 0771 system system
    mkdir /data/local 0751 root root
    mkdir /data/local/tmp 0771 root root
    mkdir /data/var 0755 root root
    mkdir /data/var/lib 0755 root root
    mkdir /data/var/cache 0755 root root
    mkdir /data/var/log 0755 root root

on boot
    write /proc/sys/net/ipv4/tcp_fastopen 3
    chmod 0666 /dev/dri/card0
    chmod 0666 /dev/dri/card1
    chmod 0666 /dev/dri/renderD128
    chown system graphics /dev/dri/card0
    chown system graphics /dev/dri/card1
    chown system graphics /dev/dri/renderD128
    chmod 0660 /dev/input/event*
    chown system input /dev/input/event*
    class_start core
    class_start main

service ueventd /system/bin/udevd
    class early
    critical
